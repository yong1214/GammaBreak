# API host/port for the GammaBreak backend
API_HOST=0.0.0.0
API_PORT=8000

# Bearer token required by the iOS app (generate any random string)
API_AUTH_TOKEN=change-me-to-a-long-random-string

# IBKR TWS / IB Gateway connection (the desktop app must be running)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497=TWS paper, 7496=TWS live, 4002=Gateway paper, 4001=Gateway live
IBKR_CLIENT_ID=17

# Polygon free tier (optional; only used for realized vol). Leave blank to skip.
POLYGON_API_KEY=

# External dealer-GEX provider (OPTIONAL).
# If you don't have one, leave POLYGON_API_KEY / FLASHALPHA_API_KEY blank and
# the backend will compute approximate gamma walls from the IBKR option chain.
# Free public APIs for dealer GEX are rare; SpotGamma / MenthorQ / GammaSwap
# are paid. Plug in the right base URL + key here if you subscribe.
FLASHALPHA_API_KEY=
FLASHALPHA_BASE_URL=https://api.flashalpha.io/v1

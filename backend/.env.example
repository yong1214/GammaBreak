# API host/port for the GammaBreak backend
API_HOST=0.0.0.0
API_PORT=8000

# Bearer token required by the iOS app (generate any random string)
API_AUTH_TOKEN=change-me-to-a-long-random-string

# IBKR TWS / IB Gateway connection (the desktop app must be running)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497=TWS paper, 7496=TWS live, 4002=Gateway paper, 4001=Gateway live
IBKR_CLIENT_ID=17

# Polygon free tier
POLYGON_API_KEY=your-polygon-key

# FlashAlpha free tier
FLASHALPHA_API_KEY=your-flashalpha-key
FLASHALPHA_BASE_URL=https://api.flashalpha.io/v1
